{
    "name": "dereuromark/cakephp-audit-stash",
    "description": "Flexible and rock solid audit log tracking plugin for cakephp",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "audit",
        "admin-panel",
        "standalone-ui",
        "logging",
        "history",
        "tracking"
    ],
    "license": "MIT",
    "homepage": "https://dereuromark.github.io/cakephp-audit-stash/",
    "require": {
        "php": ">=8.5",
        "cakephp/orm": "^6.0@dev",
        "ext-json": "*",
        "sebastian/diff": "^8.0 || ^9.0"
    },
    "require-dev": {
        "cakephp/cakephp": "^6.0@dev",
        "phpunit/phpunit": "^13.0",
        "php-collective/code-sniffer": "dev-master",
        "cakephp/migrations": "dev-fix/6.x-cakephp-compatibility",
        "cakephp/elastic-search": "dev-cake-6",
        "dereuromark/cakephp-templating": "dev-cake6",
        "dereuromark/cakephp-i18n-lint": "dev-cake6"
    },
    "suggest": {
        "cakephp/elastic-search": "Optional Elasticsearch persister for high-volume audit log storage",
        "jfcherng/php-diff": "For enhanced word-level diff rendering in AuditHelper (falls back to sebastian/diff if not installed)"
    },
    "autoload": {
        "psr-4": {
            "AuditStash\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "AuditStash\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "vendor/bin/phpstan analyze",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json",
        "test": "phpunit",
        "coverage-test": "phpunit --stderr --coverage-clover=clover.xml",
        "i18n-check": "i18n-lint check",
        "i18n-extract": "i18n-lint extract",
        "i18n-lint": "i18n-lint lint"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
